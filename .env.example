# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DataForSEO API Credentials (Required for live keyword mining & search volume)
DATAFORSEO_LOGIN="your-dataforseo-login-email"
DATAFORSEO_PASSWORD="your-dataforseo-api-password"

# Amazon Associates Affiliate Tag (Standardized for all outbound product links)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG="thesuburbanoutpost-20"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Tracking & Verification (Optional)
VITE_GA4_ID="G-XXXXXXXXXX"
VITE_GTM_ID="GTM-XXXXXXX"
VITE_GSC_VERIFICATION="google-site-verification-token"

# Photography APIs (Optional for external image queries)
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
PEXELS_API_KEY="your-pexels-api-key"
